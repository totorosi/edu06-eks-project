# docker compose 가 읽는 값. 이 파일을 .env 로 복사한 뒤 값을 정하세요 (.env 는 git 에 올리지 않음)

# DB 비밀번호 (필수): root 와 API 용 계정이 같은 값을 씀
DB_PASSWORD=change-me

# DB 계정 이름: API 가 접속하는 MySQL 계정
DB_USER=appuser

# 이미지 이름: 로컬에서만 쓰면 그대로 두고, Docker Hub 에 push 하려면 <내 Docker Hub ID>/fastapi:member-api 로 바꿈
FASTAPI_IMAGE=member-api:local

# API 를 호출할 수 있는 프론트 주소 (쉼표로 구분)
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
