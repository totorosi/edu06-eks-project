{
  "id": null,
  "uid": "eks-integrated-logs",
  "title": "EKS Integrated Logs",
  "tags": [
    "eks",
    "logs"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "namespace",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "pod",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{namespace=~\"$namespace\"}",
          "type": 1
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "node",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"node/journal\"}",
          "type": 1
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "search",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Row 1. Ingress ALB 액세스 로그 (Loki)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "[1-A] 상태코드별 요청 추이",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (elb_status) (count_over_time({job=\"alb-logs\"} | pattern `<type> <ts> <elb> <client>:<cport> <target> <req_t> <target_t> <resp_t> <elb_status> <target_status> <rx> <tx> \"<method> <url> <proto>\" \"<ua>\" <_>` [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{elb_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "[1-C] ALB 자체 에러 (타깃 연결 실패 5xx)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"alb-logs\"} | pattern `<type> <ts> <elb> <client>:<cport> <target> <req_t> <target_t> <resp_t> <elb_status> <target_status> <rx> <tx> \"<method> <url> <proto>\" \"<ua>\" <_>` | elb_status=~\"5..\" | target_status=\"-\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "[1-D] 느린 URL Top 10 (평균 타깃 응답시간)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, avg by (url) (avg_over_time({job=\"alb-logs\"} | pattern `<type> <ts> <elb> <client>:<cport> <target> <req_t> <target_t> <resp_t> <elb_status> <target_status> <rx> <tx> \"<method> <url> <proto>\" \"<ua>\" <_>` | target_t > 0 | unwrap target_t [$__range])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "[1-E] 요청 많은 클라이언트 IP Top 10",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (client) (count_over_time({job=\"alb-logs\"} | pattern `<type> <ts> <elb> <client>:<cport> <target> <req_t> <target_t> <resp_t> <elb_status> <target_status> <rx> <tx> \"<method> <url> <proto>\" \"<ua>\" <_>` [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{client}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "[1-B] 5xx 에러 로그",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"alb-logs\"} | pattern `<type> <ts> <elb> <client>:<cport> <target> <req_t> <target_t> <resp_t> <elb_status> <target_status> <rx> <tx> \"<method> <url> <proto>\" \"<ua>\" <_>` | elb_status=~\"5..\" | line_format \"{{.elb_status}} (target:{{.target_status}}) {{.method}} {{.url}} client={{.client}} target={{.target}} {{.target_t}}s\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "[1-F] 원본 로그 (검색어 필터)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"alb-logs\"} |~ \"$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Row 2. RDS 로그 (CloudWatch Logs)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "[2-A] 슬로우 쿼리 발생 추이",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "stats count(*) as slow_queries by bin(5m)",
          "statsGroups": [],
          "logGroups": [
            {
              "arn": "arn:aws:logs:${region}:${account_id}:log-group:/aws/rds/instance/${name_prefix}-mysql/slowquery",
              "name": "/aws/rds/instance/${name_prefix}-mysql/slowquery"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "[2-D] 접속 거부 건수",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "filter @message like /Access denied/\n| stats count(*) as denied",
          "statsGroups": [],
          "logGroups": [
            {
              "arn": "arn:aws:logs:${region}:${account_id}:log-group:/aws/rds/instance/${name_prefix}-mysql/error",
              "name": "/aws/rds/instance/${name_prefix}-mysql/error"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "[2-B] 슬로우 쿼리 Top 20",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "parse @message /Query_time: (?<query_time>[\\d.]+)\\s+Lock_time: (?<lock_time>[\\d.]+)\\s+Rows_sent: (?<rows_sent>\\d+)\\s+Rows_examined: (?<rows_examined>\\d+)/\n| filter ispresent(query_time)\n| fields @timestamp, query_time, lock_time, rows_examined, @message\n| sort query_time desc\n| limit 20",
          "statsGroups": [],
          "logGroups": [
            {
              "arn": "arn:aws:logs:${region}:${account_id}:log-group:/aws/rds/instance/${name_prefix}-mysql/slowquery",
              "name": "/aws/rds/instance/${name_prefix}-mysql/slowquery"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "[2-C] 에러 / 경고 로그",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, @message\n| filter @message like /(?i)(\\[ERROR\\]|\\[Warning\\]|aborted|denied)/\n| sort @timestamp desc\n| limit 200",
          "statsGroups": [],
          "logGroups": [
            {
              "arn": "arn:aws:logs:${region}:${account_id}:log-group:/aws/rds/instance/${name_prefix}-mysql/error",
              "name": "/aws/rds/instance/${name_prefix}-mysql/error"
            }
          ]
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Row 3. EKS Control Plane & Events (CloudWatch Logs + Loki)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "[3-E] Warning 이벤트 사유별 추이",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (count_over_time({job=\"kubernetes-events\"} | logfmt | type=\"Warning\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "[3-G] 주요 장애 이벤트 건수",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 54,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"kubernetes-events\"} |~ \"BackOff|FailedScheduling|OOMKilling|Unhealthy|FailedMount\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 16,
      "type": "logs",
      "title": "[3-F] Warning 이벤트 목록",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 62,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"kubernetes-events\"} | logfmt | namespace=~\"$namespace\" | type=\"Warning\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "[3-A] 리소스 변경 이력 (누가 / 무엇을)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 70,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, user.username, verb, objectRef.resource, objectRef.namespace, objectRef.name, responseStatus.code\n| filter @logStream like /kube-apiserver-audit/\n| filter verb in [\"create\", \"update\", \"patch\", \"delete\"]\n| filter user.username not like /^system:/\n| sort @timestamp desc\n| limit 100",
          "statsGroups": [],
          "logGroups": [
            {
              "arn": "arn:aws:logs:${region}:${account_id}:log-group:/aws/eks/${cluster}/cluster",
              "name": "/aws/eks/${cluster}/cluster"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "[3-B] API 응답 코드 분포",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 79,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "filter @logStream like /kube-apiserver-audit/\n| stats count(*) as cnt by responseStatus.code\n| sort cnt desc",
          "statsGroups": [],
          "logGroups": [
            {
              "arn": "arn:aws:logs:${region}:${account_id}:log-group:/aws/eks/${cluster}/cluster",
              "name": "/aws/eks/${cluster}/cluster"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "[3-C] 권한 거부(403) 요청",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 12,
        "y": 79,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, user.username, verb, objectRef.resource, objectRef.namespace\n| filter @logStream like /kube-apiserver-audit/ and responseStatus.code = 403\n| sort @timestamp desc\n| limit 50",
          "statsGroups": [],
          "logGroups": [
            {
              "arn": "arn:aws:logs:${region}:${account_id}:log-group:/aws/eks/${cluster}/cluster",
              "name": "/aws/eks/${cluster}/cluster"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
